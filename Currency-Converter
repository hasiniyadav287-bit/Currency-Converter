print("=== Currency Converter ===")
print("1. INR to USD")
print("2. USD to INR")
print("3. INR to EUR")
print("4. EUR to INR")
choice = input("Choose an option (1-4): ")
amount = float(input("Enter amount: "))
if choice == "1":
    result = amount * 0.012
    print("Converted Amount:", round(result, 2), "USD")
elif choice == "2":
    result = amount * 83.0
    print("Converted Amount:", round(result, 2), "INR")
elif choice == "3":
    result = amount * 0.011
    print("Converted Amount:", round(result, 2), "EUR")
elif choice == "4":
    result = amount * 91.0
    print("Converted Amount:", round(result, 2), "INR")
else:
    print("Invalid choice!")



